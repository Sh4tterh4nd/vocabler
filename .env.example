# Set a password before starting Compose. Never commit your real .env.
POSTGRES_PASSWORD=
POSTGRES_DB=vocabler
POSTGRES_USER=vocabler

# For a published release, use ghcr.io/<owner>/<repository>:v1.0.0 or an image digest.
VOCABLER_IMAGE=vocabler:local
VOCABLER_BIND_ADDRESS=127.0.0.1
VOCABLER_PORT=8080

# Set true when serving the application through an HTTPS reverse proxy.
VOCABLER_SECURE_COOKIE=false
